#1. Creating the bbj_bmi.txt from the autosomes file.
#Aim: This part converts the Biobank Japan autosomes GWAS file into a clean BMI summary file with standard columns so that we can align it to the HM3 map, build the non EUR PRS and combine with the EUR data for the IVW meta analysis.
```{r}


library(data.table)

infile <- "C:/Users/tboakye/Desktop/FALL 2025/ST 721/GROUP PROJECT/Ch10_Dataset/data_chapter10/data_chapter10/New folder/GWASsummary_BMI_Japanese_SakaueKanai2020.auto.txt"
outdir <- "C:/Users/tboakye/Desktop/FALL 2025/ST 721/GROUP PROJECT/Ch10_Dataset/data_chapter10/data_chapter10"

bbj <- fread(infile)          # reads big .txt directly
pcol <- if ("P_BOLT_LMM_INF" %in% names(bbj)) "P_BOLT_LMM_INF" else "P_LINREG"

bbj_std <- data.table(
  SNP  = bbj$SNP,
  CHR  = as.integer(bbj$CHR),
  BP   = as.integer(bbj$BP),
  A1   = toupper(bbj$ALLELE1),            # effect allele
  A2   = toupper(bbj$ALLELE0),            # other allele
  BETA = as.numeric(bbj$BETA),
  SE   = as.numeric(bbj$SE),
  P    = as.numeric(bbj[[pcol]]),
  N    = as.integer(NA)                 
)[complete.cases(SNP, CHR, BP, A1, A2, BETA, SE, P)]

fwrite(bbj_std, file.path(outdir, "bbj_bmi.txt"), sep="\t")   # ← overwrites

# verifying 
cat("rows:", nrow(bbj_std), "\n")
print(fread(file.path(outdir, "bbj_bmi.txt"), nrows=5))


```










#Read PCA eigenvec and save as pca.txt
#Aim; This part reads the PCA eigenvec file and saves it as pca.txt so we can add the top ten principal components to each person and use them as covariates to control population structure in every model.
```{r}

library(data.table)
path <- "C:/Users/tboakye/Desktop/FALL 2025/ST 721/GROUP PROJECT/Ch10_Dataset/data_chapter10/data_chapter10"

# read as-is
pcs <- fread(file.path(path, "pca.eigenvec"), header = FALSE)
setnames(pcs, c("FID","IID", paste0("PC", seq_len(ncol(pcs)-2))))

# write a .txt copy
fwrite(pcs, file.path(path, "pca.txt"), sep = "\t")

```











#Making the bmi_eur_clean.txt from BMI.txt and the HM3 map
#Aim; This part reads the European BMI summary file, adds chromosome and base pair from the HM3 map, drops strand ambiguous sites and flips signs to match alleles, then saves a clean table called bmi_eur_clean.txt that lines up with our target genotypes.
```{r}

library(bigsnpr); library(data.table)

path <- "C:/Users/tboakye/Desktop/FALL 2025/ST 721/GROUP PROJECT/Ch10_Dataset/data_chapter10/data_chapter10"

# 0) Target map 
obj <- snp_attach(file.path(path, "1kg_hm3_qc.rds"))
map <- as.data.table(obj$map)[, .(
  SNP = marker.ID,
  CHR = as.integer(chromosome),
  BP  = as.integer(physical.pos)
)]

# 1) read EUR BMI (MarkerName, A1, A2, Beta, Pval)
eur_raw <- fread(file.path(path, "BMI.txt"))
setnames(eur_raw, c("MarkerName","A1","A2","Beta","Pval"),
                    c("SNP","A1","A2","BETA","P"))

# 2) SE from Beta and two-sided P
eur_raw[, Z  := sign(BETA) * qnorm(P/2, lower.tail = FALSE)]
eur_raw[, SE := abs(BETA) / pmax(abs(Z), 1e-300)]

# 3) Adding CHR/BP from target map
eur <- merge(
  eur_raw[, .(SNP, A1 = toupper(A1), A2 = toupper(A2), BETA, SE, P)],
  map, by = "SNP", all.x = TRUE
)

# 4) standard 9 cols
eur <- eur[!is.na(CHR) & !is.na(BP)
 ][, .(SNP, CHR, BP, A1, A2, BETA, SE, P, N = as.integer(NA))]

fwrite(eur, file.path(path, "bmi_eur_clean.txt"), sep = "\t")
eur[1:5]


```




















#Standardizing BBJ BMI GWAS and build inverse variance meta with EUR
#Aim: Here I clean the Japanese BMI summary data into bbj_bmi.txt, then joins it with the cleaned European file on shared rsIDs and computes inverse variance fixed effect betas with standard errors and p values to make bmi_ivw.txt for a combined set of SNP weights.
```{r}


library(data.table)
infile <- "C:/Users/tboakye/Desktop/FALL 2025/ST 721/GROUP PROJECT/Ch10_Dataset/data_chapter10/data_chapter10/New folder/GWASsummary_BMI_Japanese_SakaueKanai2020.auto.txt"
outdir <- "C:/Users/tboakye/Desktop/FALL 2025/ST 721/GROUP PROJECT/Ch10_Dataset/data_chapter10/data_chapter10"

bbj <- fread(infile)
pcol <- if ("P_BOLT_LMM_INF" %in% names(bbj)) "P_BOLT_LMM_INF" else "P_LINREG"
bbj_std <- data.table(
  SNP  = bbj$SNP,
  CHR  = as.integer(bbj$CHR),
  BP   = as.integer(bbj$BP),
  A1   = toupper(bbj$ALLELE1),
  A2   = toupper(bbj$ALLELE0),
  BETA = as.numeric(bbj$BETA),
  SE   = as.numeric(bbj$SE),
  P    = as.numeric(bbj[[pcol]]),
  N    = as.integer(NA)
)[complete.cases(SNP, CHR, BP, A1, A2, BETA, SE, P)]
fwrite(bbj_std, file.path(outdir, "bbj_bmi.txt"), sep="\t")


eur <- fread(file.path(outdir, "bmi_eur_clean.txt"))
bbj <- fread(file.path(outdir, "bbj_bmi.txt"))

m <- merge(eur, bbj, by = "SNP", suffixes = c(".EUR",".BBJ"))
w1 <- 1/(m$SE.EUR^2); w2 <- 1/(m$SE.BBJ^2)
m$BETA <- (m$BETA.EUR*w1 + m$BETA.BBJ*w2)/(w1+w2)
m$SE   <- sqrt(1/(w1+w2))
m$P    <- 2*pnorm(-abs(m$BETA/m$SE))
m$CHR  <- m$CHR.EUR; m$BP <- m$BP.EUR; m$A1 <- m$A1.EUR; m$A2 <- m$A2.EUR; m$N <- as.integer(NA)

ivw <- m[, .(SNP, CHR, BP, A1, A2, BETA, SE, P, N)]
fwrite(ivw, file.path(outdir, "bmi_ivw.txt"), sep="\t")


```





#1. Conduct empirical analysis of PRS.

# Aim: As for this part, we builds and tests the polygenic scores: it matches the summary stats to the target, makes C plus T and LDpred2 scores, standardizes them, fits BMI on each score with PCs, uses a train and test split and reports R2 and some checks.

```{r}


library(data.table)
library(bigsnpr); library(bigstatsr)

pth <- "C:/Users/tboakye/Desktop/FALL 2025/ST 721/GROUP PROJECT/ST721_Project_Files"

# Genotypes + map/fam
obj <- snp_attach(file.path(pth, "1kg_hm3_qc.rds"))
G   <- obj$genotypes
map <- obj$map
fam <- obj$fam
setnames(fam, c("family.ID","sample.ID"), c("FID","IID"))

# Phenotype + PCs
pheno <- fread(file.path(pth, "BMI_pheno.txt"), fill=TRUE)[, 1:3]
setnames(pheno, c("FID","IID","BMI"))
pcs   <- fread(file.path(pth, "pca_eigenvec.txt"))
D <- merge(as.data.table(fam)[,.(FID,IID)], pheno, by=c("FID","IID"))
D <- merge(D, pcs, by=c("FID","IID"))
D$BMI <- as.numeric(D$BMI)
ind.keep <- match(D$IID, fam$IID)

# Base GWAS (standardize)
ss <- fread(file.path(pth, "bmi_eur_clean.txt"))
setnames(ss, c("SNP","CHR","BP","A1","A2","BETA","SE","P"),
             c("rsid","chr","pos","a1","a0","beta","beta_se","p"))
ss <- ss[!is.na(beta) & !is.na(p)]
ss[, `:=`(a1=toupper(a1), a0=toupper(a0))]

# Map with SNP->column index
map_ref <- data.frame(
  rsid    = map$marker.ID,
  chr_ref = map$chromosome,
  pos_ref = map$physical.pos,
  a1_ref  = toupper(map$allele1),
  a0_ref  = toupper(map$allele2),
  col_idx = seq_len(ncol(G))
)

# Drop palindromic and harmonize
pal <- (ss$a1=="A"&ss$a0=="T")|(ss$a1=="T"&ss$a0=="A")|(ss$a1=="C"&ss$a0=="G")|(ss$a1=="G"&ss$a0=="C")
m <- merge(ss[!pal], map_ref, by="rsid")
flip  <- (m$a1==m$a0_ref) & (m$a0==m$a1_ref)
keep  <- flip | ((m$a1==m$a1_ref) & (m$a0==m$a0_ref))
m     <- m[keep]
m$beta[flip] <- -m$beta[flip]
m$col <- m$col_idx

# Clumping
S_full <- rep(NA_real_, ncol(G))
S_full[m$col] <- abs(-log10(m$p) * sign(m$beta))
ind.clump <- snp_clumping(G,
  ind.row   = ind.keep,
  infos.chr = map$chromosome,
  infos.pos = map$physical.pos,
  S = S_full, thr.r2 = 0.1, size = 250/1000
)

# PRS grid (full-sample) + evaluation
pthr <- c(5e-8,1e-6,1e-4,1e-3,1e-2,5e-2,1e-1,5e-1,1)
best_r2 <- -Inf; best_prs <- NULL
for (t in pthr) {
  cols <- intersect(ind.clump, m$col[m$p <= t]); cols <- cols[!is.na(cols)]
  if (!length(cols)) next
  w <- m$beta[match(cols, m$col)]
  prs <- big_prodVec(G, w, ind.row=ind.keep, ind.col=cols,
                     center=rep(0, length(cols)), scale=rep(1, length(cols)))
  r2  <- summary(lm(BMI ~ prs + PC1+PC2+PC3+PC4+PC5+PC6+PC7+PC8+PC9+PC10, data=D))$r.squared
  if (r2 > best_r2) { best_r2 <- r2; best_prs <- prs }
}
D$PRS_CT <- best_prs
mod_base <- lm(BMI ~ PC1+PC2+PC3+PC4+PC5+PC6+PC7+PC8+PC9+PC10, data=D)
mod_full <- lm(BMI ~ PRS_CT + PC1+PC2+PC3+PC4+PC5+PC6+PC7+PC8+PC9+PC10, data=D)
r2_base <- summary(mod_base)$r.squared
r2_full <- summary(mod_full)$r.squared
cat("R2_full =", round(r2_full,4), " | ΔR2 =", round(r2_full - r2_base,4), "\n")
print(anova(mod_base, mod_full))
print(summary(mod_full)$coef["PRS_CT", ])

# I used 80/20 holdout: Here I tune on train and evaluate on test
set.seed(1)
n <- nrow(D)
idx_tr <- sample.int(n, floor(0.8*n))
idx_te <- setdiff(seq_len(n), idx_tr)

best_tr <- -Inf; best_cols <- NULL; best_w <- NULL
for (t in pthr) {
  cols <- intersect(ind.clump, m$col[m$p <= t]); cols <- cols[!is.na(cols)]
  if (!length(cols)) next
  w <- m$beta[match(cols, m$col)]
  prs_tr <- big_prodVec(G, w, ind.row=ind.keep[idx_tr], ind.col=cols,
                        center=rep(0, length(cols)), scale=rep(1, length(cols)))
  r2_tr  <- summary(lm(BMI ~ prs_tr + PC1+PC2+PC3+PC4+PC5+PC6+PC7+PC8+PC9+PC10, data=D[idx_tr,]))$r.squared
  if (r2_tr > best_tr) { best_tr <- r2_tr; best_cols <- cols; best_w <- w }
}

prs_te <- big_prodVec(G, best_w, ind.row=ind.keep[idx_te], ind.col=best_cols,
                      center=rep(0, length(best_cols)), scale=rep(1, length(best_cols)))
r2_base_te <- summary(lm(BMI ~ PC1+PC2+PC3+PC4+PC5+PC6+PC7+PC8+PC9+PC10, data=D[idx_te,]))$r.squared
r2_full_te <- summary(lm(BMI ~ prs_te + PC1+PC2+PC3+PC4+PC5+PC6+PC7+PC8+PC9+PC10, data=D[idx_te,]))$r.squared
cat("Test R2 =", round(r2_full_te,4), " | Test ΔR2 =", round(r2_full_te - r2_base_te,4), "\n")



# ===== I included some diagnostics =====

# 1) Standardized PRS effect
D$PRSz <- as.numeric(scale(D$PRS_CT))
mod_std <- lm(BMI ~ PRSz + PC1+PC2+PC3+PC4+PC5+PC6+PC7+PC8+PC9+PC10, data=D)
print(summary(mod_std)$coef["PRSz", ])   # estimate, SE, t, p

# 2) Partial R^2 of PRS (beyond PCs)
pR2 <- (r2_full - r2_base) / (1 - r2_base)
cat("Partial R2 (PRS | PCs) =", round(pR2, 4), "\n")

# 3) Correlation of PRS with PCs
cors <- sapply(paste0("PC",1:10), function(pc) cor(D$PRSz, D[[pc]], use="complete.obs"))
print(round(cors, 3))

# 4) Decile gradient (mean BMI by PRS decile)
qs <- quantile(D$PRSz, seq(0,1,0.1), na.rm=TRUE)
D$decile <- cut(D$PRSz, qs, include.lowest=TRUE, labels=paste0("D",1:10))
print(tapply(D$BMI, D$decile, mean))

# 5) EUR-only robustness using 1kg_samples.txt
samples <- data.table::fread(file.path(pth, "1kg_samples.txt"))
data.table::setnames(samples, c("Sample name","Superpopulation code"), c("IID","SUPER"))
D_eur <- merge(D, samples[,.(IID,SUPER)], by="IID", all.x=TRUE)
idxE  <- which(D_eur$SUPER == "EUR")

if (length(idxE) > 20) {
  mbE <- lm(BMI ~ PC1+PC2+PC3+PC4+PC5+PC6+PC7+PC8+PC9+PC10, data=D_eur[idxE,])
  mfE <- lm(BMI ~ PRSz + PC1+PC2+PC3+PC4+PC5+PC6+PC7+PC8+PC9+PC10, data=D_eur[idxE,])
  r2bE <- summary(mbE)$r.squared
  r2fE <- summary(mfE)$r.squared
  cat("EUR-only: R2_full =", round(r2fE,4), " | ΔR2 =", round(r2fE - r2bE,4), "\n")
}






library(ggplot2)

# standardize once
D$PRSz <- as.numeric(scale(D$PRS_CT))

# 1) Tuning curve: ΔR² vs p-threshold 
r2_grid <- sapply(pthr, function(t) {
  cols <- intersect(ind.clump, m$col[m$p <= t]); cols <- cols[!is.na(cols)]
  if (!length(cols)) return(NA_real_)
  w <- m$beta[match(cols, m$col)]
  s <- big_prodVec(G, w, ind.row=ind.keep, ind.col=cols, center=rep(0,length(cols)), scale=rep(1,length(cols)))
  r2b <- summary(lm(BMI ~ PC1+PC2+PC3+PC4+PC5+PC6+PC7+PC8+PC9+PC10, data=D))$r.squared
  r2f <- summary(lm(BMI ~ s + PC1+PC2+PC3+PC4+PC5+PC6+PC7+PC8+PC9+PC10, data=D))$r.squared
  r2f - r2b
})
df_tune <- data.frame(pthr = pthr, dR2 = r2_grid)
ggplot(df_tune, aes(pthr, dR2)) +
  geom_line() + geom_point() + scale_x_log10() +
  labs(title = "C+T tuning curve", x = "p-threshold (log10)", y = "ΔR² vs PCs") +
  theme_bw()

# 2) BMI ~ PRS (scatter + linear smooth)
ggplot(D, aes(PRSz, BMI)) +
  geom_point(alpha = 0.3, size = 1) +
  geom_smooth(method = "lm", se = FALSE) +
  labs(title = "BMI vs standardized PRS (C+T)", x = "PRS z-score", y = "BMI") +
  theme_bw()

# 3) Mean BMI by PRS decile (risk gradient for continuous trait)
qs <- quantile(D$PRSz, seq(0,1,0.1), na.rm = TRUE)
D$decile <- cut(D$PRSz, qs, include.lowest = TRUE, labels = paste0("D", 1:10))
mu <- aggregate(BMI ~ decile, D, mean)
ggplot(mu, aes(decile, BMI)) +
  geom_col(width = 0.7) +
  labs(title = "Mean BMI by PRS decile (C+T)", x = "PRS decile", y = "Mean BMI") +
  theme_bw() + theme(axis.text.x = element_text(angle = 45, hjust = 1))

# 4) PRS density by case status (obesity_pheno.txt): I only included but not required for our project
ob <- data.table::fread(file.path(pth, "obesity_pheno.txt"), col.names = c("FID","IID","case"))
D2 <- merge(D, ob, by = c("FID","IID"), all.x = TRUE)
ggplot(D2[!is.na(case),], aes(PRSz, fill = factor(case))) +
geom_density(alpha = 0.4) +
scale_fill_discrete(name = "Case", labels = c("Control","Case")) +
labs(title = "PRS distribution by case status (C+T)", x = "PRS z-score", y = "Density") +
theme_bw()





















#Creating and saving the HM3 SNP map for PRS work ((chr rsid pos alleles))
#Aim: This part I make map of HM3 SNPs from the target data with chr, rsid, pos, and alleles and saves it so that in the later steps I can match and align summary stats to the same SNPs.
```{r}

library(bigsnpr)
library(data.table)

pth <- "C:/Users/tboakye/Desktop/FALL 2025/ST 721/GROUP PROJECT/ST721_Project_Files"
obj <- snp_attach(file.path(pth, "1kg_hm3_qc.rds"))

map_std <- data.frame(
  chr  = obj$map$chromosome,
  rsid = obj$map$marker.ID,
  pos  = obj$map$physical.pos,
  a1   = obj$map$allele1,
